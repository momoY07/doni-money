# Copy to .env (never commit it) or set these in your host's secret manager.
# Required. Only ever set on the server.
OPENAI_API_KEY=
# Model used for companion answers; change without an app update.
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
PORT=8787
# Limits
MAX_BODY_BYTES=16384
MAX_OUTPUT_TOKENS=600
UPSTREAM_TIMEOUT_MS=20000
RATE_PER_MINUTE=6
RATE_PER_DAY=60
DAILY_CEILING=5000
# Set to 1 only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0
